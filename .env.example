# GEMINI_API_KEY: Server-side API key for /api/assistant/chat and /api/wellness/chat.
# Configure in AI Studio Secrets or Vercel Server Environment Variables (never expose to client bundles).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public base URL where this application is hosted.
APP_URL="MY_APP_URL"

# Frontend public configuration overrides (optional in AI Studio; recommended on Vercel)
VITE_ADMIN_EMAIL="admin@example.com"
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="MY_FIRESTORE_DATABASE_ID"
